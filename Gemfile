source "https://rubygems.org"

# Match the Jekyll and plugin versions supported by GitHub Pages.
gem "github-pages", group: :jekyll_plugins

# Standard libraries required by Jekyll 3 on Ruby 3.4.
gem "base64"
gem "bigdecimal"
gem "csv"
gem "logger"
gem "webrick", "~> 1.8"

# Avoid requiring a separately compiled OpenSSL gem with portable Ruby.
gem "jekyll-remote-theme", "~> 0.4.3"
gem "wdm", "~> 0.1.0" if Gem.win_platform?
